NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# CLIENT_URL=https://tix-chat-frontend.vercel.app
# FRONTEND_URL=https://tix-chat-frontend.vercel.app
# FRONTEND_URLS=https://tix-chat-frontend.vercel.app

AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DYNAMODB_USERS_TABLE=Users
DYNAMODB_CONVERSATIONS_TABLE=Conversations
DYNAMODB_MESSAGES_TABLE=Messages
DYNAMODB_PARTICIPANTS_TABLE=Participants
DYNAMODB_CALL_SESSIONS_TABLE=tixchat-call-sessions
DYNAMODB_NOTIFICATION_TOKENS_TABLE=tixchat-notification-tokens
DYNAMODB_POSTS_TABLE=tixchat-posts
DYNAMODB_COMMENTS_TABLE=tixchat-comments
DYNAMODB_URBAN_STATS_TABLE=tixchat-urban-incident-stats

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_REGION=ap-southeast-2
AWS_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_GEO_PLACES_REGION=ap-southeast-2
AWS_GEO_ROUTES_REGION=ap-southeast-2
AWS_GEO_ROUTE_MODE=Car
AI_MAX_CONTEXT_POSTS=5
AI_DEFAULT_RADIUS_KM=5
AI_TIMEOUT_MS=12000
ASSISTANT_ROUTE_SAMPLE_METERS=150
ASSISTANT_ROUTE_INCIDENT_RADIUS_METERS=300
ASSISTANT_MEMORY_TTL_SECONDS=1800
ASSISTANT_MAX_TOOL_STEPS=6
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
OPENSEARCH_VECTOR_ENDPOINT=

AWS_LOCATION_REGION=ap-southeast-1
AWS_LOCATION_STYLE=Standard
AWS_LOCATION_COLOR_SCHEME=Light
AWS_LOCATION_VARIANT=Default
AWS_LOCATION_ALLOWED_IPS=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d 

AWS_SES_REGION=ap-southeast-2
AWS_SES_SENDER_EMAIL=

AWS_S3_REGION=
S3_BUCKET_NAME=
S3_AVATAR_FOLDER=
S3_MESSAGE_FOLDER=messages
S3_POST_IMAGES_BUCKET=
S3_POST_IMAGES_FOLDER=urban-posts

AWS_CHIME_REGION=ap-southeast-1
CHIME_MEETING_REGION=ap-southeast-1
CALL_RING_TIMEOUT_SECONDS=60

REDIS_URL=redis://redis:6379
REDIS_ENABLED=false
REDIS_URL_DOCKER=redis://redis:6379
REDIS_KEY_PREFIX=tixchat
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_DEFAULT_TTL_SECONDS=60
REDIS_POST_TTL_SECONDS=30
REDIS_USER_TTL_SECONDS=120
